;; NumSym layer: numbers on the top row + symbols, homerow mods kept.
;; Shift pairs ({[ }] <> +* ¿¡ ñÑ ´¨) sit under the left hand: Shift is the right thumb.
;; bspc/spc sit where Ext has them.
;; Shift(ralt)+number gives the host layout's shifted numbers (LatAm: !"#$%&/()=).
;;
;;        1    2    3    4    5     6    7    8    9    0
;;        ñ    {    }    ´    ¿     \    /    (    )    |
;;   @    @    <    +    =    &     ~    bspc spc  `    ^

(deflayer numsym
  _ _ _ _
          1    2    3    4    5     6    7    8    9    0
          @ñ   @ns  @nd  @nf  @¿    @\   @nk  @nl  @n;  @|
  @n@ @@  @<   @+   @=   @&         @~   bspc spc  @`   @^
  _ spc @ent _
)

;; home row mods
(defalias
  ns (t! hrm_ring   @{  $lhs)
  nd (t! hrm_middle @}  $lhs)
  nf (t! hrm_index  @´  $lhs)
  nk (t! hrm_index  @/  $rhs)
  nl (t! hrm_middle @pl $rhs)
  n; (t! hrm_ring   @pr $rhs)

  ;; lsft mirrors nubs, like @q on main
  n@ (tap-hold-release $TAPPING_TERM $TAPPING_TERM @@ lsft)
)

