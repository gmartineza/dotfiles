;; NumSym layer (RightThumb held): numbers on the top row + symbols, homerow mods kept.
;; bspc/spc sit where Ext has them.
;; Shift(homerow)+number gives the host layout's shifted numbers (LatAm: !"#$%&/()=).
;;
;;        1    2    3    4    5     6    7    8    9    0
;;        ñ    {    }    ´    ¿     \    /    (    )    |
;;   @    @    <    +    =    &     ~    bspc spc  `    ^

(deflayer numsym
  _ _ _ _ _
          1    2    3    4    5     6    7    8    9    0
          @ñ   @ns  @nd  @nf  @ng   @nj  @nk  @nl  @n;  @|
  @n@ @@  @nz  @+   @=   @&         @~   bspc spc  @n/  @^
  _ spc _ _
)

;; home row mods
(defalias
  ns (t! hrm_ring   @{  $lhs)
  nd (t! hrm_middle @}  $lhs)
  nf (t! hrm_index  @´  $lhs)
  ng (t! hrm_inner  @¿  $lhs)
  nj (t! hrm_inner  @\  $rhs)
  nk (t! hrm_index  @/  $rhs)
  nl (t! hrm_middle @pl $rhs)
  n; (t! hrm_ring   @pr $rhs)
  nz (t! hrm_bottom @<  $lhs)
  n/ (t! hrm_bottom @`  $rhs)

  ;; lsft mirrors nubs, like @q on main
  n@ (tap-hold-release $TAPPING_TERM $TAPPING_TERM @@ lsft)
)

;; vim: set ft=lisp:
