;; Custom alpha layout (emulated on a QWERTY host)
;; f6: toggle the transparent (plain keyboard) layer, f7: toggle the kbm layer.

(deflayer main
  @trs @kb ' \
       b   l   d   w   z    -   f   o   u   j
       n   @hs @hd @hf g    y   @hk @hl @h; i
  @q   q   x   m   c   v    k   p   .   /   ,
  @sym @nav @ent menu
)

;; home row mods
(defalias
  hs (t! hrm_ring   r $lhs)
  hd (t! hrm_middle t $lhs)
  hf (t! hrm_index  s $lhs)
  hk (t! hrm_index  h $rhs)
  hl (t! hrm_middle a $rhs)
  h; (t! hrm_ring   e $rhs)

  ;; lsft mirrors nubs (ANSI keyboards have no nubs), Shift when held
  q (tap-hold-release $TAPPING_TERM $TAPPING_TERM q lsft)

  trs (layer-switch transparent)
  mn  (layer-switch main)
  kb  (layer-switch kbm) ;; kbm layer: ralt->f13, menu->f14 (RL ignores ralt/menu)
)

(deflayer transparent
  @mn f7 - =
          q w e r t  u i o p [
          a s d f g  j k l ; '
  lsft nubs z x c v  m , . / rsft
  lalt spc ralt menu
)

(deflayer kbm
  @mn f7 - =
          q w e r t  u i o p [
          a s d f g  j k l ; '
  lsft nubs z x c v  m , . / rsft
  lalt spc pgdn pgup
)

;; vim: set ft=lisp:
