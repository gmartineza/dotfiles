(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  windows-altgr add-lctl-release
  concurrent-tap-hold yes ;; defchordsv2
)

(defsrc
  f6 - =
          q w e r t  y u i o p \
  caps    a s d f g  h j k l ; '
  lsft nubs z x c v  n m , . /
  spc menu
)

(defvar

  lhs (
  f6
          q w e r t
          a s   f g
  lsft nubs z x c v
  spc menu
  )

  rhs (
  f6 - =
                     y u i o p \
                     h j   l ; '
                     n m , . /
  spc menu
  )
)

;; Adapted from Kenkyo's flowtap/charmod templates (MIT, https://github.com/argenkiwi/kenkyo).
;; Change: hold side uses tap-hold-tap-keys with the same-hand key list (chordal hold).
(deftemplate modkey (char mod tapkeys)
  (switch
    ((key-timing 3 less-than 140)) $char break
    () (tap-hold-tap-keys 250 250 $char $mod $tapkeys) break
  )
)

(defalias
  trs (layer-switch transparent)
  mn  (layer-switch main)
  ;; Tap-hold modifiers
  la  (t! modkey                    r lalt $lhs)
  ls  (tap-hold-release-keys 50 250 t lsft $lhs)
  lc  (t! modkey                    s lctl $lhs)
  lar (t! modkey                    g ralt $lhs)
  rar (tap-hold-release-keys 50 250 y ralt $rhs)
  rc  (t! modkey                    h rctl $rhs)
  rs  (tap-hold-release-keys 50 250 a rsft $rhs)
  ra  (t! modkey                    e lalt $rhs)
  lm  (t! modkey                    x lmet $lhs)
  rm  (t! modkey                    / rmet $rhs)
  q   (tap-hold 250 250             q lsft)
  ;; Space: flowtap-guarded tap-hold. Tap=spc, hold=extend layer, tap-then-hold=repeat spc.
  ;; Fast-typed space stays space (no key-list primitive: any listed key would force-tap and kill nav).
  sp  (switch
        ((key-timing 3 less-than 140)) spc break
        () (tap-hold-release 250 250 spc (layer-while-held extend)) break
      )
)

(defchordsv2
  (z x) ret  50 all-released (transparent)
  (c v) bspc 50 all-released (transparent)
  (n m) bspc 50 all-released (transparent)
  (, .) ret  50 all-released (transparent)
)

(deflayer main
  @trs ' \
      b   l   d   w   z    -    f   o   u   j    =
  caps n   @la @ls @lc @lar @rar @rc @rs @ra i ;
  @q  q   @lm m   c   v    k    p   .   @rm ,
  @sp menu
)

(deflayer extend
  f6 pause prnt
       prev vold pp   volu next   nubs home up   end   pgup  _
  _    mute lalt lsft lctl pause  esc  left down right ret   lrld
  _    ret  lmet menu C-ins S-ins tab  bspc spc  del   pgdn
  _  _
)

(deflayer transparent
  @mn - =
           q w e r t  y u i o p \
  caps    a s d f g  h j k l ; '
  lsft nubs z x c v  n m , . /
  spc pgdn
)
