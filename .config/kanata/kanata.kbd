(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  windows-altgr add-lctl-release
  concurrent-tap-hold yes ;; defchordsv2
)

(defsrc
  f6 f7 - =
          q w e r t  y u i o p \
  caps    a s d f g  h j k l ; '
  lsft nubs z x c v  n m , . /
  spc ralt menu
)

(defvar

  lhs (
  f6
          q w e r t
          a s   f g
  lsft nubs z x c v
  spc menu
  )

  rhs (
  f6 - =
                     y u i o p \
                     h j   l ; '
                     n m , . /
  spc menu
  )
)

;; Adapted from Kenkyo's flowtap/charmod templates (MIT, https://github.com/argenkiwi/kenkyo).
;; Change: hold side uses tap-hold-release-keys with the same-hand key list (chordal hold).
;; Release variant: another key pressed+released while held resolves hold immediately (no timeout wait).
(deftemplate modkey (char mod tapkeys)
  (switch
    ((key-timing 3 less-than 140)) $char break
    () (tap-hold-release-keys 250 250 $char $mod $tapkeys) break
  )
)

(defalias
  trs (layer-switch transparent)
  mn  (layer-switch main)
  kb  (layer-switch kbm) ;; kbm layer: ralt->f13, menu->f14 (RL ignores ralt/menu)
  ;; Tap-hold modifiers
  lm  (t! modkey                    x lmet $lhs)
  la  (t! modkey                    r lalt $lhs)
  lc  (t! modkey                    s lctl $lhs)
  ls  (tap-hold-release-keys 50 250 t lsft $lhs)
  lar (t! modkey                    g ralt $lhs)
  rar (tap-hold-release-keys 50 250 y ralt $rhs)
  rs  (tap-hold-release-keys 50 250 a rsft $rhs)
  rc  (t! modkey                    h rctl $rhs)
  ra  (t! modkey                    e lalt $rhs)
  rm  (t! modkey                    / rmet $rhs)
  q   (tap-hold-release 250 250     q lsft)
  ;; Space: flowtap-guarded tap-hold. Tap=spc, hold=extend layer, tap-then-hold=repeat spc.
  ;; Fast-typed space stays space (no key-list primitive: any listed key would force-tap and kill nav).
  sp  (switch
        ((key-timing 3 less-than 140)) spc break
        () (tap-hold-release 250 250 spc (layer-while-held extend)) break
      )
)

;; Chord outputs skip tap-hold waiting state, so a held mod never resolves (kanata #1615).
;; Routing through a vkey makes the output go through waiting state: mod+chord resolves hold instantly.
(defvirtualkeys
  vesc  esc
  vbspc bspc
  vtab  tab
  vret  ret
)

;; Unreachable 2nd case registers $key as a repeat output: OS key-repeat ignores vkey targets.
(deftemplate vk (name key)
  (switch
    () (multi (on-press press-vkey $name) (on-release release-vkey $name)) break
    () $key break
  )
)

(defchordsv2
  (x c) (t! vk vtab tab) 50 all-released (transparent)
  (m ,) (t! vk vbspc bspc)  50 all-released (transparent)
)

(deflayer main
  @trs @kb ' \
       b   l   d   w   z    -    f   o   u   j    =
  caps n   @la @ls @lc @lar @rar @rc @rs @ra i ;
  @q   q   @lm m   c   v    k    p   .   @rm   ,
  @sp ralt menu
)

(deflayer extend
  f6 f7 pause prnt
       prev vold pp   volu next   pgup home up   end   esc  _
  _    lmet lalt lsft lctl pause  pgdn left down right ret   lrld
  _    mute _    menu C-ins S-ins tab  bspc spc  del   nubs
  _  _  _
)

(deflayer transparent
  @mn f7 - =
          q w e r t  y u i o p \
  caps    a s d f g  h j k l ; '
  lsft nubs z x c v  n m , . /
  spc ralt menu
)

(deflayer kbm
  @mn @mn - =
          q w e r t  y u i o p \
  caps    a s d f g  h j k l ; '
  lsft nubs z x c v  n m , . /
  spc pgdn pgup
)
