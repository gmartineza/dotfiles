#!/bin/sh
# post-checkout: $3 = 1 for a branch change (0 for file checkouts)
[ "$3" = 1 ] && [ -n "$ZELLIJ_SESSION_NAME" ] || exit 0
b=$(git branch --show-current | tr / -)
case "$ZELLIJ_SESSION_NAME" in
  *@"$b") ;;
  *) echo "!! now on '$b' but zellij session is '$ZELLIJ_SESSION_NAME' - switch back, or run zd" >&2 ;;
esac
